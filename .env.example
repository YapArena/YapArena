NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=debug
APP_ORIGIN=http://localhost:3000
TRUST_PROXY=false
REQUEST_BODY_LIMIT=10kb
API_RATE_LIMIT=300
AUTH_RATE_LIMIT=10
RATE_LIMIT_WINDOW_MS=900000
SESSION_DURATION_MS=604800000
POSTGRES_DB=yaparena
POSTGRES_USER=yaparena
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5433
# Local operator secrets. Compose explicitly passes only DATABASE_URL to app.
# Do not load this combined local operator file into npm run dev after provisioning.
DATABASE_OWNER_PASSWORD=local-owner-only
DATABASE_RUNTIME_PASSWORD=local-runtime-only
# The replay encoder's own login (yaparena_encoder), created by provisioning.
DATABASE_ENCODER_PASSWORD=local-encoder-only
DATABASE_URL=postgresql://yaparena_runtime:local-runtime-only@127.0.0.1:5433/yaparena
DATABASE_FIXTURE_URL=postgresql://yaparena_owner:local-owner-only@127.0.0.1:5433/yaparena
# Bearer token for GET /metrics (32+ characters). Production returns 404 while
# it is unset. Local compose uses the fixed token in monitoring/prometheus.yml.
METRICS_TOKEN=
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local-development-only

# Durable public SSE rollout. Requires migration and runtime direct/session connection.
COMMUNITY_STREAM_ENABLED=false
NODE_OPTIONS=--max-semi-space-size=4
COMMUNITY_MAX_STREAMS=500
COMMUNITY_MAX_ROOMS=50
# Live topic queue (Decision 0011). Set on web and the jobs worker together. The capacity caps
# starting and live debates; keep it at or below LiveKit's concurrent recordings (2 on Build).
# Each web process holds one more LISTEN connection for live queue updates, so DATABASE_URL must
# be a direct or session-pooler URL (never the 6543 transaction pooler).
MATCHMAKING_ENABLED=false
LIVE_DEBATE_CAPACITY=2
# Personal live updates at /api/me/stream (results notices). Always on with MATCHMAKING_ENABLED;
# with it off, set true to run them. Needs the same direct or session-pooler DATABASE_URL.
USER_STREAM_ENABLED=false
# First-run guide (web only; off until the founder approves its wording in frontend/first-run-copy.ts):
# the welcome screen on the handle pop-up's last step, and the one-time tips on debate pages with the
# coin menu's two lines. Each switch works on its own.
FIRST_RUN_WELCOME_ENABLED=false
FIRST_RUN_TIPS_ENABLED=false
# Web push for "Notify me" (needs MATCHMAKING_ENABLED). Off while WEB_PUSH_PUBLIC_KEY is empty.
# One VAPID key pair per environment, never committed: generate it with
# `node scripts/generate-web-push-keys.ts`. Web needs only the public key; whatever runs the
# background jobs (the jobs worker, or web with RUN_BACKGROUND_JOBS=true) needs both, and APP_ORIGIN.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
# Optional adaptive replay path. Configure both; legacy MP4 remains a staging fallback.
# During a staged rollout, comma-separated room UUIDs limit HLS to packaged rooms.
# Without MEDIA_REPLAY_EDGE_ROOMS, the edge applies to the entire eligible catalog.
# Only web signs replay links: the jobs worker and the encoder never need the secret.
MEDIA_REPLAY_EDGE_ROOMS=
MEDIA_REPLAY_EDGE_URL=
MEDIA_REPLAY_SIGNING_SECRET=
# Optional key that LiveKit Egress uploads recordings with (web and jobs worker), so
# MEDIA_S3_* there can be read-only. Configure both; unset, Egress gets MEDIA_S3_*.
MEDIA_EGRESS_S3_ACCESS_KEY=
MEDIA_EGRESS_S3_SECRET_KEY=
# Optional key for viewer-admission cookies (web only, at least 32 bytes). Unset, web
# signs them with LIVEKIT_API_SECRET, or a random per-process key without media.
MEDIA_ADMISSION_SECRET=

# Automatic adaptive replay runs only in a separate FFmpeg background worker.
# Keep disabled until migration, private edge and worker capacity are validated.
# The encoder needs only DATABASE_URL, MEDIA_S3_* (no public endpoint), this flag and
# optional MEDIA_REPLAY_EDGE_ROOMS; never LiveKit or replay signing secrets.
MEDIA_REPLAY_PACKAGING_ENABLED=false
MEDIA_WORKER_TOOLS=false
MEDIA_REPLAY_CONCURRENCY=1
MEDIA_REPLAY_MAX_JOB_SECONDS=1800
MEDIA_REPLAY_MAX_INPUT_MIB=2048
MEDIA_REPLAY_MAX_OUTPUT_MIB=4096

# Play-money participation only; separately enable database controls as owner.
A4_MODE=disabled
A4_STARTER_COINS=1000
A4_REFILL_COINS=1000
A4_BOT_COINS=1000

# Explicit development/test-only concept dataset at /home?reference=1. Never a live fallback.
HOMEPAGE_REFERENCE_ENABLED=false

# Optional absolute path to the landing headline font (Dydema Capitals), raw or
# as base64 text. The repository is public, so the font is never committed; on
# Render it is the secret file /etc/secrets/landing-headline-font.b64. Unset, the
# app serves public/landing/fonts/headline.woff2 if present, and the headline
# falls back to Forum otherwise. See docs/landing-page.md.
LANDING_FONT_FILE=

# Auth0 sign-in (Decision 0009): email code and Google. Web service only; the
# jobs worker never needs or receives these. Production refuses to start
# without all three. Copy ONLY runtime values to .env.runtime / hosting secrets.
# Leave them unset locally and sign in with npm run start:test-identity.
AUTH0_ISSUER_BASE_URL=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Set only on the production web service: it then refuses an *.auth0.com
# issuer and requires the production custom domain, and it is the only service
# search engines may index. Without it, every response sends X-Robots-Tag:
# noindex and /robots.txt disallows all crawling.
# PRODUCTION_SERVICE=true
# Optional shared Redis abuse controls for sign-in and API rate limits.
REDIS_SECURITY_URL=
REDIS_NAMESPACE=
REDIS_KEY_SECRET=
## Isolated simulated YC workflows only; never enables live money movement.
COIN_SANDBOX_ENABLED=false
# Decision 0012: one YC trading window per live speaking turn (web and worker).
TURN_WINDOWS_ENABLED=false
# Simulated YC purchases, withdrawals and their error reports (web). Off by
# default; the production web service refuses to start with it on.
COIN_SANDBOX_TRANSFERS_ENABLED=false
# The worker warns, and /metrics flags, a center or promotional treasury below
# this many USDC-equivalent (docs/coin-sandbox-operations.md).
# COIN_SANDBOX_TREASURY_ALERT_USDC=200000
# Decision 0012: live transcription, captions and the AI outline (web and worker).
# Needs the LIVEKIT_* media settings and, on web only, a secret shared with the
# transcriber agent.
LIVE_OUTLINE_ENABLED=false
# TRANSCRIPTION_INGEST_SECRET=
# TRANSCRIBER_AGENT_NAME=yaparena-transcriber
# Optional authenticated sandbox notification ingress; separate from all auth keys.
# COIN_SANDBOX_WEBHOOK_SECRET=
