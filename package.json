{
  "name": "yaparena",
  "version": "1.0.0",
  "description": "Backend foundation for a live debate platform",
  "scripts": {
    "build": "npm run typecheck && tsc --project tsconfig.json && tsc --project tsconfig.transcriber.json && npm run build:frontend",
    "build:frontend": "node scripts/build-frontend.ts",
    "watch:frontend": "node scripts/build-frontend.ts --watch",
    "typecheck": "npm run typecheck:operations && npm run typecheck:frontend",
    "typecheck:frontend": "node scripts/build-frontend.ts --check-sources && tsc --project tsconfig.frontend.json && tsc --project tsconfig.service-worker.json && tsc --project tsconfig.frontend-build.json",
    "test": "npm run build && node --test tests/*.test.js",
    "test:revocation": "npm run build && node --test tests/session-revocation-postgres.test.js",
    "test:coverage": "npm run build && node --test --experimental-test-coverage --test-coverage-exclude=scripts/** --test-coverage-exclude=tests/** --test-coverage-lines=90 --test-coverage-branches=90 --test-coverage-functions=90 tests/*.test.js",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "start:replay-worker": "node dist/replay-worker.js",
    "start:test-identity": "node --env-file-if-exists=.env.runtime scripts/test-identity-entry.ts",
    "dev": "node scripts/build-frontend.ts --dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run lint && npm run format:check && npm run check:files && npm run typecheck && npm run test:coverage",
    "check:fast": "npm run lint && npm run format:check && npm run check:files && npm test",
    "format:check": "prettier --check .",
    "check:files": "node scripts/check-repository-files.ts",
    "migrate": "node scripts/migrate-database.ts",
    "research:a4": "npm run build && node scripts/a4-research.js",
    "verify:a4": "npm run build && A4_VERIFY=true node scripts/verify-database-isolation.ts",
    "verify:browser": "node scripts/verify-browser-release.ts",
    "verify:database-isolation": "npm run build && node scripts/verify-database-isolation.ts",
    "inventory:database": "node scripts/inventory-database.ts",
    "seed:discovery": "node --env-file-if-exists=.env scripts/seed-discovery.ts",
    "initialize": "node scripts/initialize-project.js",
    "verify:community-delivery": "npm run build && COMMUNITY_DURABLE_TRIAL=1 node scripts/verify-community-local.ts",
    "verify:media-packaging": "node scripts/verify-media-packaging.ts",
    "verify:replay-pipeline": "npm run build && node scripts/verify-replay-pipeline.ts",
    "report:playback": "node scripts/report-playback.js",
    "typecheck:operations": "tsc --project tsconfig.json --emitDeclarationOnly && tsc --project tsconfig.database-tools.json && tsc --project tsconfig.browser-automation.json && tsc --project tsconfig.community-tools.json && tsc --project tsconfig.replay-tools.json && tsc --project tsconfig.edge.json && tsc --project tsconfig.transcriber.json --noEmit",
    "verify:community-native-setup": "npm run build && LC_ALL=C LANG=C COMMUNITY_POSTGRES_MODE=host node scripts/verify-community-local.ts --setup-only",
    "verify:auth-redis": "node scripts/verify-auth-redis.ts",
    "verify:email-auth-browser": "node scripts/verify-email-auth-browser.ts",
    "reset:test-accounts": "node scripts/reset-test-accounts.ts",
    "start:transcriber": "node dist-transcriber/features/transcription/agent/main.js start"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@livekit/local-inference@0.2.7": false
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "hls.js": "1.7.3",
    "livekit-client": "^2.23.0",
    "livekit-server-sdk": "^2.19.2",
    "node-pg-migrate": "^9.0.0",
    "openid-client": "6.8.8",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "redis": "6.3.0",
    "viem": "^2.57.10"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@eslint/js": "^10.0.1",
    "@livekit/agents": "1.9.3",
    "@livekit/agents-plugin-elevenlabs": "1.9.3",
    "@livekit/rtc-node": "1.2.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "zod": "4.6.7"
  },
  "overrides": {
    "ws": "8.22.0",
    "decode-uri-component": "0.5.0"
  }
}
