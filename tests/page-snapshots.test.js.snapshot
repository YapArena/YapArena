<circle cx="11" cy="11" r="6.6" fill="none" stroke="currentColor" stroke-width="2.2"/>
<path d="M16 16l4.6 4.6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
</svg>
<span>Explore</span>
