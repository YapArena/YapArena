<button type="button" class="cursor-interaction" data-carousel="pause" id="ya-carousel-pause" aria-label="Pause trending rotation" aria-pressed="false">Ⅱ</button>
<button type="button" class="cursor-interaction" data-carousel="next" aria-label="Next trending idea">→</button>
</div>
</div>
</section>\\n    <section class="ya-discovery" aria-label="Discover ideas">
<div class="ya-sectionhead">
<h3 id="ya-grid-title">Ideas in motion</h3>
<select class="ya-sort cursor-interaction" id="ya-sort" aria-label="Sort ideas">
<option value="active">Most active</option>
<option value="moves">Biggest shifts</option>
</select>
</div>
<div class="ya-discovery-tools">
<div class="ya-view-tabs" aria-label="Ideas view">
<button type="button" data-nav="all" aria-pressed="true">All ideas</button>
<button type="button" data-nav="following" aria-pressed="false">Following</button>
</div>
<form class="ya-idea-search" action="/topics" method="get" role="search" aria-label="Search ideas">
<label class="sr-only" for="ya-search">Search ideas</label>
<input id="ya-search" name="q" type="search" placeholder="Search ideas…" maxlength="80">
</form>
</div>
<div class="ya-filters" aria-label="Idea categories">
<button class="ya-filter" data-filter="All" aria-pressed="true" type="button">All ideas</button>
</div>
<div class="ya-grid" id="ya-grid">
<p class="ya-empty">No public ideas yet. <a href="/topics">Explore topics</a>.</p>
</div>
</section>\\n    <footer class="ya-footer footer-inner">
<span>Endorsement = share of participants choosing YES in the latest closed round.</span>
<span>Synthetic activity is labeled · <a href="/live">Watch debates</a> · <a href="/coins">Yap Coins</a>
</span>
</footer>\\n    <div id="ya-chart-tooltip" class="ya-chart-tooltip" role="tooltip" aria-hidden="true">
<strong>
</strong>
</div>\\n    <div id="ya-status" aria-live="polite" class="sr-only">
</div>\\n  <noscript>
<p class="ya-note">Idea links open their public topic pages. Enable JavaScript for inline charts, filters and previews.</p>
</noscript>
</main>\\n</div>\\n<template id="ya-home-data">{&quot;reference&quot;:false,&quot;available&quot;:true,&quot;following&quot;:[],&quot;ideas&quot;:[]}</template>
</body>
</html>
`;

