<circle cx="10.5" cy="10.5" r="6.5"/>
<path d="m16 16 5 5"/>
</svg>
<input id="header-search" type="search" name="q" maxlength="80" placeholder="Search debates…">
<button type="submit" class="sr-only">Search</button>
</form>\\n      <a class="header-search-toggle" href="/debates#debate-search" data-header-search-toggle aria-label="Search debates">
<span class="icon-search">
<svg viewBox="0 0 24 24" aria-hidden="true">
<circle cx="10.5" cy="10.5" r="6.5"/>
<path d="m16 16 5 5"/>
</svg>
</span>
