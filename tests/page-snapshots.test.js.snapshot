<path d="M14 5h5v5M19 5l-8 8M17 14v5H5V7h5"/>
</svg>View profile</a>
<button class="button-secondary" id="sign-out" type="button">Sign out</button>
</div>\\n      </header>\\n      <div class="settings-layout">\\n        <nav class="settings-nav" aria-label="Settings">\\n          <div class="settings-tabs" role="tablist" aria-orientation="vertical">
<a class="settings-tab" role="tab" id="tab-profile" href="#profile" aria-controls="panel-profile" aria-selected="true" tabindex="0">
<svg class="account-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
<circle cx="12" cy="8" r="3.5"/>
<path d="M5 21v-2a7 7 0 0 1 14 0v2"/>
</svg>
<span>Profile</span>
</a>
<a class="settings-tab" role="tab" id="tab-security" href="#security" aria-controls="panel-security" aria-selected="false" tabindex="-1">
<svg class="account-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
<path d="m12 3 8 3v6c0 5-8 9-8 9s-8-4-8-9V6l8-3Z"/>
<path d="m8.5 12 2.5 2.5 4.5-5"/>
</svg>
<span>Sign-in &amp; security</span>
</a>
<a class="settings-tab" role="tab" id="tab-notifications" href="#notifications" aria-controls="panel-notifications" aria-selected="false" tabindex="-1">
<svg class="account-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
<path d="M6 16V11a6 6 0 1 1 12 0v5l1.5 2h-15L6 16Z"/>
<path d="M10 20.5a2.2 2.2 0 0 0 4 0"/>
</svg>
<span>Notifications</span>
<span class="settings-badge" id="notification-count" hidden>
</span>
</a>
<a class="settings-tab" role="tab" id="tab-privacy" href="#privacy" aria-controls="panel-privacy" aria-selected="false" tabindex="-1">
