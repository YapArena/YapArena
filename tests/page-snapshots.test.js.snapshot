<div class="ya-layout" id="ya-trending-slide" aria-roledescription="slide" aria-label="0 of 0: The next idea is taking shape.">\\n      <aside class="ya-arguments" id="ya-arguments" aria-label="Arguments behind the trending idea">
<div class="ya-arguments-head">
<h3>Behind the position</h3>
<button type="button" class="ya-arguments-toggle cursor-interaction" id="ya-arguments-toggle" aria-label="Pause argument flow" aria-pressed="false">Ⅱ</button>
</div>
<div class="ya-arguments-window" tabindex="0" role="region" aria-label="Argument stream. Scroll or use arrow keys to browse.">
<div class="ya-argument-track" id="ya-argument-track" data-idea="empty">
<ul class="ya-argument-list">
<li class="ya-argument-item">
<div class="ya-argument-stance ">FOR THE IDEA</div>
<p class="ya-argument-text">Arguments will appear when they are available.</p>
<div class="ya-argument-endorsement">
<span>Endorse this argument</span>
<strong>—</strong>
</div>
<div class="ya-argument-meter" aria-hidden="true">
<span style="width:0%">
</span>
</div>
</li>
</ul>
<ul class="ya-argument-list" aria-hidden="true" inert>
<li class="ya-argument-item">
<div class="ya-argument-stance ">FOR THE IDEA</div>
<p class="ya-argument-text">Arguments will appear when they are available.</p>
<div class="ya-argument-endorsement">
<span>Endorse this argument</span>
<strong>—</strong>
</div>
<div class="ya-argument-meter" aria-hidden="true">
<span style="width:0%">
</span>
</div>
</li>
</ul>
</div>
</div>
<div class="ya-arguments-foot">Argument endorsements unavailable</div>
</aside>\\n      <section class="ya-feature" aria-label="Selected idea">
<div class="ya-feature-top">
<div class="ya-eyebrow">
<span class="ya-dot">
</span>
<span id="ya-category">Ideas · Trending</span>
</div>
<button class="ya-follow" type="button" id="ya-follow" data-idea="empty"  aria-pressed="false" disabled>+ Follow</button>
</div>
<h2 id="ya-title">The next idea is taking shape.</h2>
<div class="ya-metricrow">
<div>
<div>
<span class="ya-big" id="ya-value">—</span>
<span class="ya-change " id="ya-change">
</span>
</div>
<div class="ya-metric-label" id="ya-metric-label">Topic endorsement history unavailable</div>
</div>
<div class="ya-smallstats">
<div>
<span>24h volume</span>
<strong id="ya-volume">—</strong>
</div>
<div>
<span>Latest round</span>
<strong id="ya-people">—</strong>
</div>
<div>
<span>Last YES fill</span>
<strong id="ya-price">—</strong>
</div>
</div>
</div>
<div class="ya-chartbar">
<div class="ya-segments" aria-label="Chart metric">
<button type="button" data-metric="endorsement" aria-pressed="true">Endorsement</button>
<button type="button" data-metric="price" aria-pressed="false">Execution price</button>
</div>
<div class="ya-segments" aria-label="Chart period">
<button type="button" data-range="1D" aria-pressed="true">1D</button>
<button type="button" data-range="1W" aria-pressed="false">1W</button>
<button type="button" data-range="1M" aria-pressed="false">1M</button>
</div>
</div>
<svg id="ya-chart" class="ya-chart" role="img" aria-label="Idea history unavailable" viewBox="0 0 800 165">
<title>Unavailable participant endorsement, in percent</title>
<line x1="8" y1="137" x2="754" y2="137" stroke="var(--ya-line)"/>
<text x="761" y="140">0%</text>
<line x1="8" y1="80.5" x2="754" y2="80.5" stroke="var(--ya-line)"/>
<text x="761" y="83.5">50%</text>
<line x1="8" y1="24" x2="754" y2="24" stroke="var(--ya-line)"/>
<text x="761" y="27">100%</text>
<text x="376" y="82.5" text-anchor="middle">History unavailable</text>
</svg>
<div class="ya-chart-footer">
<button type="button" class="ya-event" id="ya-chart-debate" disabled>↗ Explore this idea’s debates</button>
<span>No topic market history available</span>
</div>
</section>\\n      <aside class="ya-side" id="ya-side" aria-label="Debate and participation">
<div class="ya-side-title">In the arena <span class="ya-live">UPCOMING</span>
</div>
<div class="ya-arena">
