exports[`renders the privacy, terms and cookie pages 1`] = `
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="dark">
<meta name="theme-color" content="#000000">
<title>Privacy policy · YAP Arena</title>
<meta name="description" content="What YAP Arena collects, why, who processes it, where it is stored and how long we keep it.">
<link rel="canonical" href="https://arena.example/privacy">
<meta property="og:site_name" content="YAP Arena">
