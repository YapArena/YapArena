<option value="education">Education</option>
<option value="economy">Economy</option>
<option value="other">Other</option>
</select>
</label>
<button class="btn btn-primary" type="submit">Create private draft</button>
</form>
<ul id="my-topics" class="account-list">
</ul>
</section>
<section class="card match-panel" role="tabpanel" id="match-panel-other" aria-labelledby="match-tab-other" hidden>
<h2 class="match-panel-title">
<span class="sr-only">Pick an opponent</span>
<span class="ins" aria-hidden="true">pick an opponent</span>
</h2>
<form id="challenge-create" class="stack-form">
<label>Opponent<input name="targetHandle" list="people-options" autocomplete="off" autocapitalize="none" spellcheck="false" placeholder="Search by handle or name" required>
</label>
<datalist id="people-options">
</datalist>
<label>Published topic slug<input name="topicSlug" pattern="[a-z0-9][a-z0-9-]{2,79}" required>
</label>
<label>Proposition<input name="proposition" minlength="10" maxlength="240" required>
</label>
<label>Your side<select name="requestedSide">
<option value="A">Side A</option>
<option value="B">Side B</option>
</select>
</label>
<fieldset class="choice-group match-switch">
<legend>When</legend>
<div class="match-switch-options">
<label>
<input type="radio" name="mode" value="now" checked> Now</label>
<label>
<input type="radio" name="mode" value="scheduled"> Propose times</label>
</div>
</fieldset>
<div class="challenge-times" data-challenge-times hidden>
<label>First choice, your local time<input name="time1" type="datetime-local">
</label>
<label>Second choice (optional)<input name="time2" type="datetime-local">
</label>
<label>Third choice (optional)<input name="time3" type="datetime-local">
</label>
</div>
<button class="btn btn-primary" type="submit">Send challenge</button>
</form>
<p class="form-note">Now: if they're online, they have 2 minutes to answer; otherwise the challenge waits for them. Proposed times must be 1 hour to 90 days ahead. Unanswered challenges expire after 7 days.</p>
</section>
</div>
<aside class="match-side" aria-label="Your matches">
<section class="card match-card">
<h2 class="match-card-title">
<span class="sr-only">Live queue</span>
<span class="ins" aria-hidden="true">live qveve</span>
</h2>
<p>Open a topic and queue on a side. You are matched with someone on the other side in seconds.</p>
<a class="text-link" href="/topics">Browse topics <span aria-hidden="true">→</span>
</a>
</section>
<section class="card match-card">
<h2 class="match-card-title">
<span class="sr-only">Your challenges</span>
<span class="ins" aria-hidden="true">yovr challenges</span>
</h2>
<ul id="my-requests" class="account-list">
</ul>
</section>
<section class="card match-card">
<h2 class="match-card-title">
<span class="sr-only">Your events</span>
<span class="ins" aria-hidden="true">yovr events</span>
</h2>
<ul id="my-events" class="account-list">
</ul>
</section>
<section class="card match-card">
<h2 class="match-card-title">
<span class="sr-only">Updates</span>
<span class="ins" aria-hidden="true">vpdates</span>
</h2>
<ul id="match-notifications" class="account-list">
</ul>
</section>
</aside>
</div>
</section>
<script defer src="/assets/matching.js?v=0123456789ab">
</script>
</main>
