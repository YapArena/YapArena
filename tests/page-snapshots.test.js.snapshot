<span class="vs queue-vs">
<span class="sr-only">versus</span>
<span aria-hidden="true">VS</span>
</span>
<div class="queue-side">
<p class="kicker">
<span class="sr-only">Side B</span>
<span class="ins" aria-hidden="true">side b</span>
</p>
<p class="side-label" id="queue-side-b">Side B &lt;b&gt;&amp;amp;&lt;/b&gt; &quot;quoted&quot; &#39;single&#39; &amp; &lt;</p>
<button class="btn btn-secondary queue-button" type="button" data-queue-side="B" data-side-label="Side B &lt;b&gt;&amp;amp;&lt;/b&gt; &quot;quoted&quot; &#39;single&#39; &amp; &lt;" aria-describedby="queue-side-b">Queue for this side</button>
</div>
</div>
<div class="queue-notes">
<p data-queue-waiting aria-live="polite">
</p>
<p data-queue-note role="status">
</p>
</div>
</section>
</div>
<section class="container page-section" aria-labelledby="topic-debates">
<div class="section-head">
<p class="kicker">
<span class="sr-only">On this topic</span>
<span class="ins" aria-hidden="true">on this topic</span>
</p>
<h2 class="section-title" id="topic-debates">
<span class="sr-only">Debates</span>
<span class="ins" aria-hidden="true">debates</span>
</h2>
</div>
<div class="state state-quiet">
<h3>
<span class="sr-only">No public debates on this topic yet.</span>
<span class="ins" aria-hidden="true">no pvblic debates on this topic yet.</span>
</h3>
<p>Queue on a side to start the first one.</p>
</div>
</section>
</main>
<footer class="site-footer">
