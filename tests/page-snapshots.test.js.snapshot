<main id="main">
<section class="arena-featured" data-featured-preview data-debate-preview data-event="33333333-3333-4333-8333-333333333333" data-mode="live" data-live-source="/assets/hero-live.bundle.js?v=0123456789ab" data-hls-source="/assets/replay.bundle.js?v=0123456789ab" aria-labelledby="featured-title">\\n    <img class="arena-featured-thumbnail" data-preview-thumbnail src="/api/media/events/33333333-3333-4333-8333-333333333333/thumbnail" alt="" aria-hidden="true" decoding="async">\\n    <div class="arena-featured-media" data-preview-media aria-hidden="true">
<video data-preview-video muted autoplay playsinline loop preload="none" tabindex="-1" disablepictureinpicture>
</video>
<div class="arena-featured-live" data-preview-live>
</div>
</div>\\n    <a class="arena-featured-open" data-preview-open href="/debates/public-debate" aria-label="Open debate: Should we debate this?" aria-describedby="featured-instruction">
</a>\\n    <div class="container arena-featured-copy">
<div class="arena-featured-eyebrow">
<span class="status status-live">● LIVE NOW</span>
<span>Public topic</span>
</div>
