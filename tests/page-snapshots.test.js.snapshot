</main>\\n</div>\\n<template id="ya-home-data">{&quot;reference&quot;:false,&quot;available&quot;:true,&quot;following&quot;:[],&quot;ideas&quot;:[{&quot;id&quot;:&quot;11111111-1111-4111-8111-111111111111&quot;,&quot;topicSlug&quot;:&quot;public-idea&quot;,&quot;href&quot;:&quot;/topics/public-idea&quot;,&quot;cat&quot;:&quot;Ideas&quot;,&quot;title&quot;:&quot;A real &lt;question&gt;?&quot;,&quot;short&quot;:&quot;A real &lt;question&gt;?&quot;,&quot;reference&quot;:false,&quot;demo&quot;:false,&quot;pct&quot;:null,&quot;delta&quot;:null,&quot;vol&quot;:null,&quot;people&quot;:null,&quot;price&quot;:null,&quot;points&quot;:[],&quot;viewers&quot;:null,&quot;live&quot;:1,&quot;yes&quot;:&quot;For &lt;the&gt; idea&quot;,&quot;no&quot;:&quot;Against &amp; questioning&quot;,&quot;arguments&quot;:[{&quot;stance&quot;:&quot;for&quot;,&quot;text&quot;:&quot;For &lt;the&gt; idea&quot;,&quot;rate&quot;:null},{&quot;stance&quot;:&quot;against&quot;,&quot;text&quot;:&quot;Against &amp; questioning&quot;,&quot;rate&quot;:null}],&quot;debates&quot;:[{&quot;id&quot;:&quot;22222222-2222-4222-8222-222222222222&quot;,&quot;kind&quot;:&quot;live&quot;,&quot;title&quot;:&quot;A real &lt;question&gt;?&quot;,&quot;names&quot;:[&quot;Alex Rivera&quot;,&quot;Speaker B&quot;,&quot;AR&quot;,&quot;SB&quot;],&quot;meta&quot;:&quot;Live debate&quot;,&quot;stamp&quot;:&quot;Live&quot;,&quot;href&quot;:&quot;/debates/real-debate&quot;},{&quot;id&quot;:&quot;replay&quot;,&quot;kind&quot;:&quot;replay&quot;,&quot;title&quot;:&quot;A real &lt;question&gt;?&quot;,&quot;names&quot;:[&quot;Speaker A&quot;,&quot;Morgan B&quot;,&quot;SA&quot;,&quot;MB&quot;],&quot;meta&quot;:&quot;Replay debate&quot;,&quot;stamp&quot;:&quot;Replay&quot;,&quot;href&quot;:&quot;/debates/real-debate&quot;},{&quot;id&quot;:&quot;upcoming&quot;,&quot;kind&quot;:&quot;upcoming&quot;,&quot;title&quot;:&quot;A real &lt;question&gt;?&quot;,&quot;names&quot;:[&quot;Alex Rivera&quot;,&quot;Speaker B&quot;,&quot;AR&quot;,&quot;SB&