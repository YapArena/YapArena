</script>
<link rel="stylesheet" href="/assets/homepage.css?v=0123456789ab">
<script defer src="/assets/homepage.bundle.js?v=0123456789ab">
</script>
</head>
<body class="arena-market-home">
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header" data-site-header data-session="checking">\\n    <div class="container nav arena-nav">\\n      <a class="brand" href="/home" aria-label="YAP Arena home">
<svg class="arena-brand-symbol" viewBox="0 0 40 40" aria-hidden="true">
<ellipse cx="20" cy="20" rx="13" ry="16" transform="rotate(30 20 20)"/>
<path d="M9 35 31 5"/>
</svg>
<span>YAP ARENA</span>
</a>\\n      <nav aria-label="Main navigation">
<a href="/live">Live</a>
<a href="/debates">Explore</a>
<a href="/match">Create</a>
</nav>\\n      <form class="arena-header-search" action="/debates" method="get" role="search">
<label class="sr-only" for="header-search">Search debates</label>
<svg viewBox="0 0 24 24" aria-hidden="true">
<circle cx="10.5" cy="10.5" r="6.5"/>
<path d="m16 16 5 5"/>
</svg>
<input id="header-search" type="search" name="q" maxlength="80" placeholder="Search debates…">
<button type="submit" class="sr-only">Search</button>
</form>\\n      <div class="arena-header-account">\\n        <span data-header-checking class="header-session-loading" role="status">
<span class="sr-only">Checking your account…</span>
</span>\\n        <div class="header-auth-actions" data-header-guest hidden>
<a class="header-signup" href="/account" data-header-sign-in>Sign in</a>
</div>\\n        <button class="header-retry" type="button" data-header-retry hidden>Retry account</button>\\n        <div class="header-member-actions" data-header-member hidden>\\n          <details class="arena-wallet-menu">
<summary aria-label="Yap Coins balance and actions">
<span class="header-balance-label">Balance</span>
<strong data-header-balance>—</strong>
<span class="arena-chevron" aria-hidden="true">⌄</span>
</summary>
<div class="arena-wallet-popover">
<strong data-header-balance-heading>Your Yap Coins</strong>
<span data-header-reserved>Checking balance…</span>
<a href="/coins" data-header-balances-link>Balances &amp; activity →</a>
</div>
</details>\\n          <details class="header-user-menu">
<summary class="arena-avatar" data-header-account aria-label="Open account menu">
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
<circle cx="12" cy="8" r="3.5"/>
<path d="M5 21v-2a7 7 0 0 1 14 0v2"/>
</svg>
</summary>
<div class="header-user-popover">
<span class="header-menu-caption" data-header-identity>
<span>YOUR ACCOUNT</span>
</span>
<a href="/account#profile" data-header-profile-link>Your profile</a>
<a href="/account">Settings</a>
<a href="/coins">Yap Coins</a>
<button type="button" data-header-logout>Sign out <span aria-hidden="true">↗</span>
</button>
</div>
</details>\\n        </div>\\n        <noscript>
<div class="header-auth-actions">
<a class="header-login" href="/api/auth/login?connection=google">Continue with Google</a>
<a class="header-signup" href="/api/auth/login?connection=email">Continue with email</a>
</div>
</noscript>\\n      </div>\\n      <p class="sr-only" role="status" data-header-status>
</p>\\n    </div>\\n  </header>
<div id="ya-market-v4" data-reference="false">\\n<div class="ya-ticker ya-ticker-marquee" data-static="true" aria-label="Changes in participant endorsement">
</div>\\n  <main id="main" class="ya-content">\\n    <h1 class="sr-only">Yap Arena</h1>\\n    <section class="ya-carousel" id="ya-carousel" aria-label="Trending ideas" aria-roledescription="carousel">\\n    <div class="ya-carousel-window" id="ya-carousel-window">
<div class="ya-layout" id="ya-trending-slide" aria-roledescription="slide" aria-label="0 of 0: The next idea is taking shape.">\\n      <aside class="ya-arguments" id="ya-arguments" aria-label="Arguments behind the trending idea">
<div class="ya-arguments-head">
<h3>Behind the position</h3>
<button type="button" class="ya-arguments-toggle cursor-interaction" id="ya-arguments-toggle" aria-label="Pause argument flow" aria-pressed="false">Ⅱ</button>
</div>
<div class="ya-arguments-window" tabindex="0" role="region" aria-label="Argument stream. Scroll or use arrow keys to browse.">
<div class="ya-argument-track" id="ya-argument-track" data-idea="empty">
<ul class="ya-argument-list">
<li class="ya-argument-item">
<div class="ya-argument-stance ">FOR THE IDEA</div>
<p class="ya-argument-text">Arguments will appear when they are available.</p>
<div class="ya-argument-endorsement">
<span>Endorse this argument</span>
<strong>—</strong>
</div>
<div class="ya-argument-meter" aria-hidden="true">
<span style="width:0%">
</span>
</div>
</li>
</ul>
<ul class="ya-argument-list" aria-hidden="true" inert>
<li class="ya-argument-item">
<div class="ya-argument-stance ">FOR THE IDEA</div>
<p class="ya-argument-text">Arguments will appear when they are available.</p>
<div class="ya-argument-endorsement">
<span>Endorse this argument</span>
<strong>—</strong>
</div>
<div class="ya-argument-meter" aria-hidden="true">
<span style="width:0%">
</span>
</div>
</li>
</ul>
</div>
</div>
<div class="ya-arguments-foot">Argument endorsements unavailable</div>
</aside>\\n      <section class="ya-feature" aria-label="Selected idea">
<div class="ya-feature-top">
<div class="ya-eyebrow">
<span class="ya-dot">
</span>
<span id="ya-category">Ideas · Trending</span>
</div>
<button class="ya-follow" type="button" id="ya-follow" data-idea="empty"  aria-pressed="false" disabled>+ Follow</button>
</div>
<h2 id="ya-title">The next idea is taking shape.</h2>
<div class="ya-metricrow">
<div>
<div>
<span class="ya-big" id="ya-value">—</span>
<span class="ya-change " id="ya-change">
</span>
</div>
<div class="ya-metric-label" id="ya-metric-label">Topic endorsement history unavailable</div>
</div>
<div class="ya-smallstats">
<div>
<span>24h volume</span>
<strong id="ya-volume">—</strong>
</div>
<div>
<span>Latest round</span>
<strong id="ya-people">—</strong>
</div>
<div>
<span>Last YES fill</span>
<strong id="ya-price">—</strong>
</div>
</div>
</div>
<div class="ya-chartbar">
<div class="ya-segments" aria-label="Chart metric">
<button type="button" data-metric="endorsement" aria-pressed="true">Endorsement</button>
<button type="button" data-metric="price" aria-pressed="false">Execution price</button>
</div>
<div class="ya-segments" aria-label="Chart period">
<button type="button" data-range="1D" aria-pressed="true">1D</button>
<button type="button" data-range="1W" aria-pressed="false">1W</button>
<button type="button" data-range="1M" aria-pressed="false">1M</button>
</div>
</div>
<svg id="ya-chart" class="ya-chart" role="img" aria-label="Idea history unavailable" viewBox="0 0 800 165">
<title>Unavailable participant endorsement, in percent</title>
<line x1="8" y1="137" x2="754" y2="137" stroke="var(--ya-line)"/>
<text x="761" y="140">0%</text>
<line x1="8" y1="80.5" x2="754" y2="80.5" stroke="var(--ya-line)"/>
<text x="761" y="83.5">50%</text>
<line x1="8" y1="24" x2="754" y2="24" stroke="var(--ya-line)"/>
<text x="761" y="27">100%</text>
<text x="376" y="82.5" text-anchor="middle">History unavailable</text>
</svg>
<div class="ya-chart-footer">
<button type="button" class="ya-event" id="ya-chart-debate" disabled>↗ Explore this idea’s debates</button>
<span>No topic market history available</span>
</div>
</section>\\n      <aside class="ya-side" id="ya-side" aria-label="Debate and participation">
<div class="ya-side-title">In the arena <span class="ya-live">UPCOMING</span>
</div>
<div class="ya-arena">
<div class="ya-speaker">
<div class="ya-person">A</div>Speaker A<small>FOR THE IDEA</small>
</div>
<span class="ya-vs">VS</span>
<div class="ya-speaker">
<div class="ya-person ya-against">B</div>Speaker B<small>AGAINST</small>
</div>
</div>
<div class="ya-debate-title">Explore the arena</div>
<div class="ya-audience">No playable debate yet</div>
<a class="ya-primary" href="/topics">Explore topic <span aria-hidden="true">↗</span>
</a>
<a class="ya-secondary" href="/match">Create a debate</a>
<div class="ya-round">
<span>Participation</span>
<strong>Not open</strong>
</div>
<p class="ya-note">Topic-level market data is unavailable. Debate participation uses its own published rules.</p>
</aside>\\n    </div>\\n    </div>
<div class="ya-carousel-controls">
<div class="ya-carousel-dots" id="ya-carousel-dots" aria-label="Choose trending idea">
</div>
<div class="ya-carousel-nav">
<span class="ya-carousel-count" id="ya-carousel-count">0 / 0</span>
<button type="button" class="cursor-interaction" data-carousel="previous" aria-label="Previous trending idea">←</button>
<button type="button" class="cursor-interaction" data-carousel="pause" id="ya-carousel-pause" aria-label="Pause trending rotation" aria-pressed="false">Ⅱ</button>
<button type="button" class="cursor-interaction" data-carousel="next" aria-label="Next trending idea">→</button>
</div>
</div>
</section>\\n    <section class="ya-discovery" aria-label="Discover ideas">
<div class="ya-sectionhead">
<h3 id="ya-grid-title">Ideas in motion</h3>
<select class="ya-sort cursor-interaction" id="ya-sort" aria-label="Sort ideas">
<option value="active">Most active</option>
<option value="moves">Biggest shifts</option>
</select>
</div>
<div class="ya-discovery-tools">
<div class="ya-view-tabs" aria-label="Ideas view">
<button type="button" data-nav="all" aria-pressed="true">All ideas</button>
<button type="button" data-nav="following" aria-pressed="false">Following</button>
</div>
<form class="ya-idea-search" action="/topics" method="get" role="search" aria-label="Search ideas">
<label class="sr-only" for="ya-search">Search ideas</label>
<input id="ya-search" name="q" type="search" placeholder="Search ideas…" maxlength="80">
</form>
</div>
<div class="ya-filters" aria-label="Idea categories">
<button class="ya-filter" data-filter="All" aria-pressed="true" type="button">All ideas</button>
</div>
<div class="ya-grid" id="ya-grid">
<p class="ya-empty">No public ideas yet. <a href="/topics">Explore topics</a>.</p>
</div>
</section>\\n    <footer class="ya-footer footer-inner">
<span>Endorsement = share of participants choosing YES in the latest closed round.</span>
<span>Synthetic activity is labeled · <a href="/live">Watch debates</a> · <a href="/coins">Yap Coins</a>
</span>
</footer>\\n    <div id="ya-chart-tooltip" class="ya-chart-tooltip" role="tooltip" aria-hidden="true">
<strong>
</strong>
</div>\\n    <div id="ya-status" aria-live="polite" class="sr-only">
</div>\\n  <noscript>
<p class="ya-note">Idea links open their public topic pages. Enable JavaScript for inline charts, filters and previews.</p>
</noscript>
</main>\\n</div>\\n<template id="ya-home-data">{&quot;reference&quot;:false,&quot;available&quot;:true,&quot;following&quot;:[],&quot;ideas&quot;:[]}</template>
</body>
</html>
`;

