<svg viewBox="0 0 24 24" aria-hidden="true">
<path data-preview-toggle-icon d="m8 5 11 7-11 7Z"/>
</svg>
</button>
</div>\\n  </article>
<article class="debate-card arena-video-card" data-card-preview data-debate-preview data-event="55555555-5555-4555-8555-555555555555" data-mode="replay" data-live-source="/assets/hero-live.bundle.js?v=0123456789ab" data-hls-source="/assets/replay.bundle.js?v=0123456789ab">\\n    <img class="arena-featured-thumbnail" data-preview-thumbnail src="/api/media/events/55555555-5555-4555-8555-555555555555/thumbnail" alt="" aria-hidden="true" loading="lazy" decoding="async">\\n    <div class="arena-featured-media" data-preview-media aria-hidden="true">
<video data-preview-video muted autoplay playsinline loop preload="none" tabindex="-1" disablepictureinpicture>
</video>
<div class="arena-featured-live" data-preview-live>
</div>
</div>\\n    <a class="arena-featured-open" data-preview-open href="/debates/hostile-debate" aria-label="Watch debate: Proposition &lt;b&gt;&amp;amp;&lt;/b&gt; &quot;quoted&quot; &#39;single&#39; &amp; &lt;">
</a>\\n    <div class="arena-video-card-top">
<span class="status status-replay">REPLAY</span>
<span class="arena-video-card-topic">Topic &lt;b&gt;&amp;amp;&lt;/b&gt; &quot;quoted&quot; &#39;single&#39; &amp; &lt;</span>
</div>\\n    <div class="arena-video-card-copy">
<h3>Proposition &lt;b&gt;&amp;amp;&lt;/b&gt; &quot;quoted&quot; &#39;single&#39; &amp; &lt;</h3>
<p>Morgan &lt;b&gt;&amp;amp;&lt;/b&gt; &quot;quoted&quot; &#39;single&#39; &amp; &lt;</p>
<span class="arena-video-card-entry" aria-hidden="true">Step into the debate ↗</span>
</div>\\n    <div class="arena-video-card-controls">
<span class="sr-only" data-preview-status>Preview paused</span>
<button type="button" class="arena-featured-toggle" data-preview-toggle aria-label="Play video preview" aria-pressed="true">
<svg viewBox="0 0 24 24" aria-hidden="true">
