<form class="community-inline-form" data-community-visibility>
<label>Item <select name="targetType" required>
<option value="topic">Topic (slug)</option>
<option value="profile">Profile (handle)</option>
<option value="debate">Debate (slug or ID)</option>
</select>
</label>
<label>Slug, handle or ID <input name="target" required maxlength="100" autocomplete="off" spellcheck="false">
</label>
<label>Reason to hide <select name="reasonCode">
<option value="">Choose a reason</option>
<option value="harassment">harassment</option>
<option value="hate">hate</option>
<option value="threat">threat</option>
<option value="spam">spam</option>
<option value="privacy">privacy</option>
<option value="other">other</option>
</select>
</label>
<label>Review note <textarea name="note" required minlength="10" maxlength="500" rows="3">
</textarea>
</label>
<button type="submit" value="hide">Hide from public pages</button>
<button type="submit" value="restore">Restore</button>
</form>
<h3>Recent visibility changes</h3>
<ol data-community-visibility-log>
</ol>
</section>
</div>
</section>
