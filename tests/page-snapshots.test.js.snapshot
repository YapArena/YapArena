<path d="M8.5 10.5V7.5a3.5 3.5 0 0 1 7 0v3"/>
</svg>
<span>Privacy &amp; data</span>
</a>
</div>\\n          <a class="settings-tab settings-tab-link" href="/coins">
<svg class="account-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
<circle cx="12" cy="12" r="8.5"/>
<path d="M14.5 9.2c-.6-.8-1.5-1.2-2.6-1.2-1.6 0-2.6.8-2.6 2s1 1.7 2.7 2c1.7.3 2.7.9 2.7 2.1 0 1.3-1.1 2.1-2.7 2.1-1.2 0-2.2-.5-2.8-1.4M12 6.5V8m0 8v1.5"/>
</svg>
<span>Yap Coins</span>
<span class="settings-tab-arrow" aria-hidden="true">↗</span>
</a>\\n        </nav>\\n        <div class="settings-panels">\\n        <section class="settings-panel" role="tabpanel" id="panel-profile" aria-labelledby="tab-profile" tabindex="-1">\\n          <div class="settings-card">\\n            <div class="settings-card-head">
<div>
<h2>Public profile</h2>
<p>How you show up in debates, chat and search.</p>
</div>
</div>\\n            <div class="settings-banner" id="profile-state-box" hidden>
<p id="profile-state" role="status">
</p>
<button class="button-secondary" type="button" id="profile-publish" hidden>Make it public</button>
</div>\\n            <form id="profile-form" class="settings-form" novalidate>\\n              <div class="settings-field">\\n                <div class="settings-label-row">
<label for="profile-display-name">Username</label>
<span class="settings-count" data-count-for="profile-display-name" aria-hidden="true">0/80</span>
</div>\\n                <input id="profile-display-name" name="displayName" maxlength="80" autocomplete="name" required aria-describedby="profile-display-name-error">\\n                <p class="settings-error" id="profile-display-name-error" data-error-for="displayName" hidden>
</p>\\n              </div>\\n              <div class="settings-field">\\n                <div class="settings-label-row">
<label for="profile-handle">Handle</label>
<span class="settings-lock">
<svg class="account-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
<rect x="5" y="10.5" width="14" height="10" rx="2.5"/>
<path d="M8.5 10.5V7.5a3.5 3.5 0 0 1 7 0v3"/>
</svg>Permanent</span>
</div>\\n                <div class="settings-handle">
<span aria-hidden="true">@</span>
<input id="profile-handle" name="handle" readonly aria-describedby="profile-handle-help">
</div>\\n                <p class="settings-help" id="profile-handle-help">Handles never change, so links to you never break. <a id="profile-url" href="/account#profile">
</a>
</p>\\n              </div>\\n              <div class="settings-field">\\n                <div class="settings-label-row">
<label for="profile-bio">Bio</label>
<span class="settings-count" data-count-for="profile-bio" aria-hidden="true">0/500</span>
</div>\\n                <textarea id="profile-bio" name="bio" maxlength="500" rows="4" placeholder="A little about you and the ideas you care about." aria-describedby="profile-bio-error">
</textarea>\\n                <p class="settings-error" id="profile-bio-error" data-error-for="bio" hidden>
</p>\\n              </div>\\n              <div class="settings-save">
<p id="profile-save-status" role="status" aria-live="polite">
</p>
<button class="button" type="submit" disabled>Save changes</button>
</div>\\n            </form>\\n          </div>\\n          <div class="settings-card">\\n            <div class="settings-card-head">
<div>
<h2>Following</h2>
<p>People and topics you follow. Follow more from their public pages.</p>
</div>
</div>\\n            <ul id="follow-list" class="settings-list">
</ul>\\n          </div>\\n        </section>\\n        <section class="settings-panel" role="tabpanel" id="panel-security" aria-labelledby="tab-security" tabindex="-1" hidden>\\n          <div class="settings-card">\\n            <div class="settings-card-head">
<div>
<h2>Sign-in methods</h2>
<p>The ways you can sign in to this account.</p>
</div>
</div>\\n            <ul id="sign-in-methods" class="settings-methods">
</ul>\\n            <p class="settings-help">Google and an email code for the same address both open this account. Signing out ends your session on this device only.</p>\\n          </div>\\n          <div class="settings-card">\\n            <div class="settings-card-head">
<div>
<h2>Recent account activity</h2>
<p>Sign-ins and changes from the last 90 days.</p>
</div>
</div>\\n            <ul id="activity-list" class="settings-list settings-timeline">
</ul>\\n            <a class="settings-link" href="/account/moderation">My reports and appeals<span aria-hidden="true">→</span>
</a>\\n          </div>\\n        </section>\\n        <section class="settings-panel" role="tabpanel" id="panel-notifications" aria-labelledby="tab-notifications" tabindex="-1" hidden>\\n          <div class="settings-card">\\n            <div class="settings-card-head">
<div>
<h2>Notifications</h2>
<p>Updates about your debates, sign-ins and account.</p>
</div>
</div>\\n            <ul id="account-notifications" class="settings-list settings-notifications">
</ul>\\n          </div>\\n        </section>\\n        <section class="settings-panel" role="tabpanel" id="panel-privacy" aria-labelledby="tab-privacy" tabindex="-1" hidden>\\n          <div class="settings-card settings-row-card">\\n            <span class="settings-card-icon">
<svg class="account-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
<path d="M4 19h16M7 16v-4m5 4V8m5 8v-6"/>
</svg>
</span>\\n            <div>
<h2>Usage measurement</h2>
<p>We only count page views and watch time if you allow it, and you can turn it off and delete that data anytime.</p>
</div>\\n            <button class="button-secondary" type="button" data-open-measurement>Measurement settings</button>\\n          </div>\\n          <div class="settings-card settings-row-card">\\n            <span class="settings-card-icon">
<svg class="account-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
<path d="M12 4v11m-5-5 5 5 5-5M5 20h14"/>
</svg>
</span>\\n            <div>
<h2>Download your data</h2>
<p>A JSON file with your profile, sign-in methods, follows, notifications and account activity.</p>
</div>\\n            <a class="button-secondary" href="/api/me/export" download data-export>Download</a>\\n          </div>\\n        </section>\\n        </div>\\n      </div>\\n    </div>\\n  </section>\\n  <script defer src="/assets/account.js?v=0123456789ab">
</script>
</main>
<footer class="site-footer">
<div class="container footer-inner">
<span>YAP ARENA <span class="muted">/ Ideas under pressure.</span>
</span>
<span>
<a href="/topics">Topics</a> · <a href="/coins">Yap Coins</a> · <a href="/about">About</a> · Play money</span>
</div>
</footer>
</body>
</html>
`;

