<header class="site-header" data-site-header data-session="checking" data-avatar-src="/assets/avatars/{id}.svg?v=0123456789ab">\\n    <div class="container site-header-grid">\\n      <a class="site-logo" href="/home">
<img src="/assets/landing/yaparena-logo.png?v=0123456789ab" width="575" height="151" alt="YAP Arena home">
</a>\\n      <nav class="site-nav" aria-label="Main navigation">
<a href="/live">Live</a>
<a href="/queue">Queue</a>
<a href="/debates">Explore</a>
<a href="/match">Create</a>
</nav>\\n      <form class="arena-header-search" action="/debates" method="get" role="search" data-header-search>
